file(STRINGS "${SDK_ROOT}/SHA256SUMS" entries)
foreach(entry IN LISTS entries)
    string(SUBSTRING "${entry}" 0 64 expected)
    string(SUBSTRING "${entry}" 66 -1 path)
    if(NOT EXISTS "${SDK_ROOT}/${path}")
        message(FATAL_ERROR "Missing SDK file ${path}")
    endif()
    file(SHA256 "${SDK_ROOT}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "SDK checksum mismatch for ${path}")
    endif()
endforeach()
